// Cloudflare Workers config: serves the static build in dist/ (no Worker code).
// _headers and _redirects in dist/ apply here too.
{
  "name": "magick-agency-www",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /privacy serves privacy.html and /privacy.html redirects to /privacy.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
