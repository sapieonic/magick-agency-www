---
import Base from './Base.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import { SITE } from '@/data/site'
import { graph, organization, webPage, website } from '@/lib/schema'

interface Props {
  title: string
  heading: string
  description: string
  path: string
}

const { title, heading, description, path } = Astro.props
const updatedLabel = new Date(`${SITE.legalUpdated}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
const crumbs = [
  { name: 'Home', path: '/' },
  { name: heading, path },
]
const jsonLd = graph(
  organization(),
  website(),
  webPage({ path, title, description, breadcrumbs: crumbs, dateModified: SITE.legalUpdated, aboutProduct: false }),
)
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="legal container">
    <Breadcrumbs items={crumbs} />
    <header>
      <p class="label">Legal</p>
      <h1>{heading}</h1>
      <p class="updated">
        Last updated: <time datetime={SITE.legalUpdated}>{updatedLabel}</time>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .legal {
    max-width: calc(800px + var(--gutter) * 2);
    padding-top: 28px;
    padding-bottom: var(--section-y);
  }

  header {
    margin: clamp(32px, 5vw, 56px) 0 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: clamp(36px, 5vw, 52px);
  }

  .updated {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
  }

  .prose {
    display: grid;
    gap: 40px;
    color: var(--ink-2);
    font-size: 16.5px;
  }

  .prose :global(section) {
    display: grid;
    gap: 12px;
    scroll-margin-top: 96px;
  }

  .prose :global(h2) {
    font-size: clamp(22px, 2.6vw, 26px);
  }

  .prose :global(h3) {
    margin-top: 10px;
    color: var(--accent-ink);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 8px;
    padding-left: 22px;
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li::marker) {
    color: var(--periwinkle);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent-ink);
    text-decoration: underline;
    text-decoration-color: rgba(91, 63, 196, 0.35);
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }
</style>
