---
import Icon from '@/components/Icon.astro'
import Screen from '@/components/Screen.astro'
import { CONTACT_LINKS, LINKS, STATS } from '@/data/site'
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="container">
    <p class="label hero-label">
      <span class="live-dot" aria-hidden="true"></span>
      Power dialer for call centres, BPOs and collection agencies
    </p>

    <div class="hero-head">
      <h1 id="hero-title">
        Keep every agent on a call. <span class="quiet">Know how every call went.</span>
      </h1>
      <div class="hero-side">
        <p class="hero-lead">
          Magick Agency dials your lists the moment an agent is free, reviews every call with AI and puts the numbers in
          your inbox each morning. Agents work from a browser or the mobile app.
        </p>
        <div class="hero-ctas">
          <a href={CONTACT_LINKS.demo} class="btn btn-primary" data-track-cta="hero" data-cta-label="Book a demo">
            Book a demo
          </a>
          <a href="#product" class="arrow-link" data-track-cta="hero" data-cta-label="See the product">
            See the product <Icon name="arrow-right" size={17} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="stage">
      <div class="grid-backdrop" aria-hidden="true"></div>
      <Screen shot="overview" class="stage-browser" priority />
      <Screen
        shot="mobileStation"
        frame="phone"
        class="stage-phone"
        sizes="(min-width: 1264px) 240px, max(124px, 19vw)"
        eager
      />
    </div>

    <dl class="facts">
      {STATS.map((s) => (
        <div>
          <dt class="label-sm">{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
    <p class="hero-signin">
      Already using Magick Agency?{' '}
      <a class="text-link" href={LINKS.app} data-app-link>
        Sign in to the console
      </a>
    </p>
  </div>
</section>

<style>
  .hero {
    padding: clamp(56px, 9vw, 112px) 0 clamp(64px, 8vw, 96px);
  }

  .hero-label {
    margin-bottom: 28px;
  }

  .hero-head {
    display: grid;
    gap: 32px 72px;
  }

  .hero h1 {
    max-width: 14ch;
    font-size: clamp(42px, 6.6vw, 84px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-side {
    display: grid;
    align-content: end;
    gap: 28px;
    max-width: 460px;
  }

  .hero-lead {
    color: var(--muted);
    font-size: clamp(16.5px, 1.4vw, 18px);
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
  }

  @media (min-width: 1000px) {
    .hero-head {
      grid-template-columns: 1.4fr 1fr;
      align-items: end;
    }
  }

  /* ---------------- Product stage ---------------- */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: clamp(48px, 7vw, 80px);
    padding: clamp(20px, 4.5vw, 56px) clamp(16px, 4.5vw, 56px) 0;
    border-radius: var(--radius-lg);
    background: radial-gradient(60% 50% at 50% 0%, rgb(var(--accent-rgb) / 0.35), transparent 70%), var(--dark);
  }

  .stage :global(.stage-browser) {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
    border-color: rgba(255, 255, 255, 0.1);
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 -20px 80px -30px rgb(var(--accent-rgb) / 0.6);
  }

  .stage :global(.stage-phone) {
    position: absolute;
    right: clamp(12px, 5vw, 64px);
    bottom: clamp(-120px, -6vw, -40px);
    width: clamp(124px, 19vw, 240px);
  }

  /* ---------------- Facts row ---------------- */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .facts > div {
    padding: 22px 20px 22px 0;
    border-top: 1px solid var(--line);
  }

  .facts dd {
    margin: 8px 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  @media (min-width: 900px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 0;
    }

    .facts > div {
      padding-left: 24px;
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .facts > div:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  .hero-signin {
    margin-top: 20px;
    color: var(--muted);
    font-size: 14.5px;
  }
</style>
