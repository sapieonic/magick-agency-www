---
import SectionHead from '@/components/SectionHead.astro'
import Steps from '@/components/Steps.astro'
import { homeIndex, STEPS } from '@/data/site'
---

<section class="section section--soft" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <SectionHead id="how-title" index={homeIndex('how-it-works')} label="How it works">
      From a CSV to a busy floor. <span class="quiet">In an afternoon.</span>
      <Fragment slot="lead">
        No servers, SIP trunks or desk phones to set up. Everything runs in the browser and the app.
      </Fragment>
    </SectionHead>

    <Steps steps={STEPS} />
  </div>
</section>
