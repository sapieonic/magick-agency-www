---
import SectionHead from '@/components/SectionHead.astro'
import { CONTACT, CONTACT_LINKS } from '@/data/site'

interface Props {
  faqs: readonly { q: string; a: string }[]
  title?: string
  /** Section number on the home page, e.g. "09". */
  index?: string
  soft?: boolean
}

const { faqs, title = 'Questions, answered', index, soft = false } = Astro.props
---

<section class:list={['section', 'section--rule', { 'section--soft': soft }]} id="faq" aria-labelledby="faq-title">
  <div class="container split">
    <SectionHead id="faq-title" index={index} label="FAQ" layout="stack">
      {title}
      <Fragment slot="lead">
        Still curious? Write to{' '}
        <a class="text-link" href={`mailto:${CONTACT.salesEmail}`} data-track-email="faq">
          {CONTACT.salesEmail}
        </a>{' '}
        or{' '}
        <a class="text-link" href={CONTACT_LINKS.demo}>
          book a demo
        </a>
        .
      </Fragment>
    </SectionHead>

    <div class="faqs" data-reveal>
      {faqs.map((f, i) => (
        <details class="faq" open={i === 0}>
          <summary>
            <h3>{f.q}</h3>
            <span class="faq-plus" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faqs {
    border-top: 1px solid var(--ink);
  }

  .faq {
    border-bottom: 1px solid var(--line-strong);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    transition: color 0.2s;
  }

  summary:hover h3 {
    color: var(--accent-ink);
  }

  .faq-plus {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }

  .faq-plus::before,
  .faq-plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 14px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .faq-plus::after {
    transform: rotate(90deg);
  }

  .faq[open] .faq-plus::after {
    transform: rotate(0deg);
  }

  .faq-answer {
    max-width: 62ch;
    padding: 0 0 24px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }
</style>
