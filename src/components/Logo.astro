---
interface Props {
  size?: number
}

const { size = 34 } = Astro.props
// The mark is 558×634, so height follows width.
const height = Math.round((size * 634) / 558)
---

<span class="logo">
  <img
    src="/brand/logo-64.webp"
    srcset="/brand/logo-64.webp 1x, /brand/logo-128.webp 2x"
    width={size}
    height={height}
    alt=""
    decoding="async"
    style={`width:${size}px;height:${height}px`}
  />
  <span class="logo-word">
    Magick <span>Agency</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo-word {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .logo-word span {
    color: var(--accent);
  }
</style>
