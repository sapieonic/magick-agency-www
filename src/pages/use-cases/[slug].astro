---
import SectionHead from '@/components/SectionHead.astro'
import Steps from '@/components/Steps.astro'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import Base from '@/layouts/Base.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Icon from '@/components/Icon.astro'
import Faq from '@/components/Faq.astro'
import Cta from '@/components/Cta.astro'
import UseCases from '@/components/home/UseCases.astro'
import { CONTACT, CONTACT_LINKS, PLATFORM_SPECS, SITE, STATS, USE_CASES, absUrl, useCasePath } from '@/data/site'
import { ORG_ID, faqPage, graph, organization, software, webPage, website } from '@/lib/schema'

export const getStaticPaths = (() =>
  USE_CASES.map((useCase) => ({ params: { slug: useCase.slug }, props: { useCase } }))) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { useCase } = Astro.props
const path = useCasePath(useCase.slug)
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Use cases', path: '/use-cases' },
  { name: useCase.title, path },
]

const jsonLd = graph(
  organization(),
  website(),
  software(),
  webPage({ path, title: useCase.seoTitle, description: useCase.seoDescription, breadcrumbs: crumbs }),
  {
    '@type': 'Service',
    '@id': `${absUrl(path)}#service`,
    name: `Power dialer for ${useCase.title.toLowerCase()}`,
    serviceType: useCase.title,
    description: useCase.intro,
    provider: { '@id': ORG_ID },
    areaServed: SITE.country,
    audience: { '@type': 'BusinessAudience', name: useCase.industries.join(', ') },
  },
  faqPage(path, useCase.faqs),
)
---

<Base title={useCase.seoTitle} description={useCase.seoDescription} path={path} jsonLd={jsonLd}>
  <article>
    <header class="uc-hero">
      <div class="container">
        <Breadcrumbs items={crumbs} />
        <div class="uc-hero-grid">
          <div>
            <p class="label">Use case / {useCase.title}</p>
            <h1>{useCase.headline}</h1>
            <p class="lead">{useCase.intro}</p>
            <div class="uc-ctas">
              <a
                href={CONTACT_LINKS.demo}
                class="btn btn-primary"
                data-track-cta={`use_case_${useCase.slug}`}
                data-cta-label="Book a demo"
              >
                Book a demo <Icon name="arrow-right" size={18} class="icon-shift" />
              </a>
              <a href="/#product" class="btn btn-ghost">
                <Icon name="play" size={16} /> See the product
              </a>
            </div>
            <p class="uc-aria">
              Questions first? Write to{' '}
              <a href={`mailto:${CONTACT.salesEmail}`} data-track-email={`use_case_${useCase.slug}`}>
                {CONTACT.salesEmail}
              </a>
              .
            </p>
          </div>
          <ul class="uc-stats" aria-label="Magick Agency in numbers">
            {STATS.map((s) => (
              <li>
                <strong>{s.value}</strong>
                <span class="label-sm">{s.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </header>

    <section class="section section--soft" aria-labelledby="does-title">
      <div class="container uc-two">
        <div data-reveal>
          <SectionHead id="does-title" label="How Magick Agency helps" layout="stack" reveal={false}>
            Your agents talk. The rest is handled.
          </SectionHead>
          <ul class="checks rule-list">
            {useCase.helps.map((item) => (
              <li>
                <Icon name="check" size={18} strokeWidth={2.5} />
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="uc-side" data-reveal style="--delay:120ms">
          <div class="card side-card">
            <h3 class="label-sm">Popular with</h3>
            <ul class="tags">
              {useCase.industries.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
          <div class="card side-card">
            <h3 class="label-sm">Under the hood</h3>
            <p>{PLATFORM_SPECS}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="flow-title">
      <div class="container">
        <SectionHead id="flow-title" label="How it works">
          Four steps, from list to learning
        </SectionHead>
        <Steps steps={useCase.flow} />
      </div>
    </section>
  </article>

  <Faq faqs={useCase.faqs} title={`${useCase.title}: common questions`} soft />
  <UseCases exclude={useCase.slug} label="More use cases">
    Other ways teams use Magick Agency
  </UseCases>
  <Cta title={`See Magick Agency run ${useCase.title.toLowerCase()}`} location={`use_case_${useCase.slug}_footer`} />
</Base>

<style>
  .uc-hero {
    padding: 28px 0 clamp(56px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .uc-hero-grid {
    display: grid;
    gap: 40px;
    align-items: end;
    margin-top: clamp(32px, 5vw, 56px);
  }

  .uc-hero h1 {
    max-width: 18ch;
    font-size: clamp(36px, 5.4vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .uc-hero .lead {
    max-width: 640px;
  }

  .uc-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .uc-aria {
    margin-top: 18px;
    color: var(--muted);
    font-size: 15px;
  }

  .uc-aria a {
    color: var(--accent-ink);
    font-weight: 600;
    white-space: nowrap;
  }

  .uc-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .uc-stats li {
    display: grid;
    gap: 6px;
    padding: 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .uc-stats strong {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .uc-two {
    display: grid;
    gap: 40px;
  }

  .uc-two :global(.section-head) {
    margin-bottom: 0;
  }

  .checks {
    margin-top: 32px;
  }

  .checks li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    color: var(--ink);
    font-size: 16.5px;
  }

  .checks :global(svg) {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--accent);
  }

  .uc-side {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .side-card {
    padding: 22px 24px;
  }

  .side-card h3 {
    margin-bottom: 12px;
  }

  .side-card p {
    color: var(--ink-2);
    font-size: 15.5px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .tags li {
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
  }

  @media (min-width: 1000px) {
    .uc-hero-grid {
      grid-template-columns: 1.5fr 1fr;
    }

    .uc-two {
      grid-template-columns: 1.3fr 1fr;
      gap: 64px;
    }
  }
</style>
