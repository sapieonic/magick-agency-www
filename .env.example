# Where the "Request a demo" form POSTs its JSON. Leave empty and the form opens the visitor's
# email app with the request addressed to sales instead.
PUBLIC_CONTACT_ENDPOINT=

# PostHog analytics (optional). Only runs on www.magick-agency.com (or the apex), and only after the
# visitor grants analytics consent in the CookieHub banner (SITE.gaMeasurementId and SITE.cookieHubId).
PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
